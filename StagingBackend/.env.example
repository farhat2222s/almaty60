# Copy to .env on your private server; never commit populated secrets.
NODE_ENV=production
PORT=3080
HOST=127.0.0.1
DATABASE_URL=postgresql://al60_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/almaty60
DATABASE_SSL=true
# Optional provider CA certificate; verification is always enabled for TLS.
DATABASE_CA_FILE=
# Only true for a private same-host Docker database network.
DATABASE_INTERNAL=false
# 32 random bytes encoded as 64 hex characters, stable across restarts.
TOKEN_ENCRYPTION_KEY=
SESSION_HOURS=24
# Native clients have no Origin. Browser clients need an exact approved HTTPS origin.
ALLOWED_ORIGINS=
# Enable only when API cannot be reached except through your trusted reverse proxy.
TRUST_PROXY=false
# Docker deployment settings.
STAGING_DOMAIN=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Operator-only provisioning; clear after use. Never present these values in UI/logs.
BOOTSTRAP_ROLE=admin
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Staging operator
BOOTSTRAP_BRAND_ID=
